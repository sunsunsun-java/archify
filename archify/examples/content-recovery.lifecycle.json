  "transitions": [
    {
      "id": "advance-0",
      "from": "phase-0",
      "to": "phase-1"
    },
    {
      "id": "advance-1",
      "from": "phase-1",
      "to": "phase-2"
    },
    {
      "id": "advance-2",
      "from": "phase-2",
      "to": "phase-3"
    },
    {
      "id": "advance-3",
      "from": "phase-3",
      "to": "phase-4"
    },
    {
      "id": "recover-0",
      "from": "phase-2",
      "to": "event-0"
    },
    {
      "id": "recover-1",
      "from": "phase-3",
      "to": "event-1"
    },
    {
      "id": "recover-2",
      "from": "phase-4",
      "to": "event-2"
    },
    {
      "id": "resolve-0",
      "from": "event-0",
      "to": "outcome-0",
      "label": "retry exhausted",
      "labelAt": [402, 600]
    },
    {
      "id": "resolve-1",
      "from": "event-1",
      "to": "outcome-1",
      "label": "review rejected",
      "labelAt": [556, 600]
    },
    {
      "id": "resolve-2",
      "from": "event-2",
      "to": "outcome-2",
      "label": "receipt confirmed",
      "labelAt": [710, 600]
    }
  ]
}
